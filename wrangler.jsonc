{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clarify",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
