# Server-only env vars for Clarify (never NEXT_PUBLIC_*)
# Set these in Cloudflare Pages → Settings → Environment variables
# (Production + Preview), or via:
#   npx wrangler pages secret put DATABASE_URL --project-name=clarify
#   npx wrangler pages secret put ADMIN_PASSWORD --project-name=clarify
#   npx wrangler pages secret put SESSION_SECRET --project-name=clarify
#
# ADMIN_PASSWORD elevates the Guide admin account after viewer sign-in.
# ADMIN_EMAIL (optional) defaults to guidelearning.skyrocket801@passmail.net —
# only that signed-in user sees the admin key icon.
# Viewer accounts use email/password (+ optional TOTP) in Neon
# (sql/006_users_engagement.sql, sql/007_totp.sql). SESSION_SECRET signs
# admin + viewer + pending-2FA cookies.

DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_EMAIL=guidelearning.skyrocket801@passmail.net
SESSION_SECRET=
# Bearer/query secret for /api/cron/sync (GitHub Actions schedule)
CRON_SECRET=
